# The online game server for "Play online" (the Render service from render.yaml), set in Vercel's
# Environment Variables. Leave empty to use a server on the same computer as the page (port 8787).
VITE_MULTIPLAYER_URL=wss://snake-multiplayer.onrender.com

# Neon Postgres for the Top 10. Vercel's Neon integration sets this for you.
DATABASE_URL=
