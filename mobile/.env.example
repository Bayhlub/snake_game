# Copy to .env.local and set the address of the Top 10 API: the Vercel site (web/), or a deployed Laravel app.
# Leave empty to keep scores on the phone. A phone can't reach snake_game.test, so use a deployed (https) URL,
# e.g. https://snake-game-drab-eight-36.vercel.app
EXPO_PUBLIC_API_URL=

# The online game server (npm run multiplayer on your computer prints its Wi-Fi address).
# Players can also type or change it on the "Play online" screen.
EXPO_PUBLIC_MULTIPLAYER_URL=
