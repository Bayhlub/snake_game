# Copy to .env.local and set the address of the deployed Laravel app for the online leaderboard.
# Leave empty to play without a leaderboard. A phone can't reach snake_game.test, so use a deployed (https) URL.
EXPO_PUBLIC_API_URL=

# The online game server (npm run multiplayer on your computer prints its Wi-Fi address).
# Players can also type or change it on the "Play online" screen.
EXPO_PUBLIC_MULTIPLAYER_URL=
